{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/stream",
      "destination": "/api/stream.js"
    },
    {
      "source": "/api/realtime",
      "destination": "/api/realtime.js"
    },
    {
      "source": "/api/pelada",
      "destination": "/api/pelada.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
